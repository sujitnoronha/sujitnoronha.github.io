<h1>Blog</h1>

<p>Write-ups on AI research, voice systems, and engineering.</p>

<ul class="post-list">
{%- for post in collections.posts | reverse %}
  <li>
    <time datetime="{{ post.date | postDate }}">{{ post.date | postDate }}</time>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </li>
{%- endfor %}
</ul>
