<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != "Sujit Noronha" %}{{ title }} · Sujit Noronha{% else %}Sujit Noronha{% endif %}</title>
  <meta name="description" content="{{ description or "Sujit Noronha — machine learning engineer. Voice AI, LLM post-training, inference optimization, and evaluation." }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22 font-family=%22Georgia%22>S</text></svg>">
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/">Sujit Noronha</a>
    <nav class="site-nav">
      <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a>
      <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
      <a href="/projects/" {% if page.url == "/projects/" %}aria-current="page"{% endif %}>Projects</a>
      <a href="/blog/" {% if "/blog/" in page.url %}aria-current="page"{% endif %}>Blog</a>
      <a href="/updates/" {% if page.url == "/updates/" %}aria-current="page"{% endif %}>Updates</a>
      <a href="/contact/" {% if page.url == "/contact/" %}aria-current="page"{% endif %}>Contact</a>
    </nav>
  </header>

  <div class="layout">
    <aside class="sidebar">
      {% include "pixel-avatar.njk" %}
      <p class="sidebar-name">Sujit Noronha</p>
      <p class="sidebar-bio">Founding ML Engineer @ <a href="https://kidco.ai">Kidco.AI</a>. Voice AI, LLM post-training, inference optimization, and evals.</p>
      <ul class="sidebar-meta">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Los Altos, CA</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><a href="mailto:snoronha@ucsc.edu">Email</a></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg><a href="https://github.com/sujitnoronha">GitHub</a></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/><path d="M10 9h3.8v1.7h.1A4.2 4.2 0 0 1 17.5 9c3 0 4.5 1.9 4.5 5.3V21h-4v-6c0-1.6-.5-2.7-2-2.7-1.6 0-2 1.3-2 2.7v6h-4z"/></svg><a href="https://linkedin.com/in/sujitnoronha">LinkedIn</a></li>
      </ul>
    </aside>

    <main>
      {{ content | safe }}
    </main>
  </div>

  <footer class="site-footer">
    <p>© 2026 Sujit Noronha · <a href="https://github.com/sujitnoronha">GitHub</a> · <a href="https://linkedin.com/in/sujitnoronha">LinkedIn</a> · <a href="mailto:snoronha@ucsc.edu">Email</a></p>
  </footer>

  <script src="/js/animate.js"></script>
</body>
</html>
