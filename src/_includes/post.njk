---
layout: base.njk
---
<article class="post">
  {% if banner %}<div class="post-banner">{% include "banners/" + banner + ".njk" %}</div>{% endif %}
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta"><time datetime="{{ page.date | postDate }}">{{ page.date | postDate }}</time></p>
  </header>
  {{ content | safe }}
</article>

<p class="post-back"><a href="/blog/">← All posts</a></p>
